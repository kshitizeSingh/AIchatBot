# API Gateway Environment Configuration
# Copy this file to .env and update with your specific values

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Environment
NODE_ENV=production
TZ=UTC

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret (MUST match across all services)
# Generate a strong 256-bit secret key
JWT_SECRET=your-256-bit-secret-key-change-in-production-12345678

# Redis Password (for caching)
REDIS_PASSWORD=defaultpassword

# =============================================================================
# AWS CONFIGURATION
# =============================================================================

# AWS Credentials for S3 storage
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=faq-documents

# =============================================================================
# PINECONE CONFIGURATION
# =============================================================================

# Pinecone Vector Database
PINCONE_API_KEY=your-pinecone-api-key
PINCONE_INDEX_NAME=faq-platform
PINCONE_ENVIRONMENT=us-east-1-aws

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Grafana Admin Password
GRAFANA_PASSWORD=admin

# Prometheus Configuration
PROMETHEUS_RETENTION=15d

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================

# Rate Limiting
RATE_LIMIT_API=10r/s
RATE_LIMIT_AUTH=5r/s
RATE_LIMIT_UPLOAD=2r/s

# Connection Limits
CONN_LIMIT_PER_IP=20

# Timeouts (in seconds)
PROXY_CONNECT_TIMEOUT=5
PROXY_SEND_TIMEOUT=60
PROXY_READ_TIMEOUT=60

# =============================================================================
# SSL/TLS CONFIGURATION (for production)
# =============================================================================

# SSL Certificate paths (uncomment for HTTPS)
# SSL_CERTIFICATE_PATH=/etc/ssl/certs/api.faq-platform.com.crt
# SSL_CERTIFICATE_KEY_PATH=/etc/ssl/private/api.faq-platform.com.key

# Domain name for SSL certificate
# DOMAIN_NAME=api.faq-platform.com

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-frontend-domain.com

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log levels: debug, info, notice, warn, error, crit, alert, emerg
LOG_LEVEL=info

# Log rotation
LOG_MAX_SIZE=100M
LOG_MAX_FILES=10

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Worker processes (auto = number of CPU cores)
WORKER_PROCESSES=auto

# Worker connections per process
WORKER_CONNECTIONS=1024

# Keepalive timeout
KEEPALIVE_TIMEOUT=65

# Client body size limits
CLIENT_MAX_BODY_SIZE=2M
CLIENT_MAX_BODY_SIZE_UPLOAD=50M

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================

# Health check intervals (in seconds)
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# =============================================================================
# BACKUP AND MAINTENANCE
# =============================================================================

# Backup retention
BACKUP_RETENTION_DAYS=30

# Maintenance window (UTC time)
MAINTENANCE_WINDOW_START=02:00
MAINTENANCE_WINDOW_END=04:00

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Uncomment for development environment
# NODE_ENV=development
# LOG_LEVEL=debug
# ALLOWED_ORIGINS=*